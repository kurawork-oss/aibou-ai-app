# .env.example — AIbou Brain API の環境変数（コピーして .env を作る）
# 本番（Cloud Run / HF Spaces）は実環境変数 / Secrets に同名で設定する。

# 必須: Gemini（chat / vision を使うなら）
GEMINI_API_KEY=

# 任意: Supabase（記憶 memory / 収益 income を使うなら）。service role キーを推奨。
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 任意: APIを保護するBearerトークン。設定すると /health 以外で
#       Authorization: Bearer <APP_TOKEN> が必須になる。空ならオープン。
APP_TOKEN=

# 任意: CORS許可オリジン。"*" で全許可。カンマ区切りで複数指定可
#       例: https://your-frontend.vercel.app
FRONTEND_ORIGIN=*

# ── ほかのAI（任意。入れた分だけ使えるようになる） ─────────────────
#
# 入れただけでは**使われない**。お金がかかる物（Claude・GPT・Grok）は、
# 設定 →「どのAIに任せるか」でその仕事に指名したときだけ使う。
# 勝手に使い始めると、請求はあなたに行く。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
HUGGINGFACE_TOKEN=

# 手元のOllama。立てている人だけ。外へ出ないので、見せたくない文章に向く。
# 既定値は入れない（立てていない人の所で毎回1回ぶん待つことになる）。
OLLAMA_URL=
OLLAMA_MODEL=

# どの仕事をどこへ回すか（空なら無料の物から自動）。
# 画面から設定できるので、ふつうは触らなくてよい。
# 値は gemini | huggingface | ollama | anthropic | openai | grok
ROUTE_CHAT=
ROUTE_CODE=
ROUTE_LONG=
ROUTE_PRIVATE=
ROUTE_VISION=

# ── 保存先をテーブルごと作る（任意） ───────────────────────────────
# postgresql://… の接続文字列。入れると、設定画面から表と守り（RLS）を
# まとめて作れる。入れなくても動くが、そのときは守りの状態を数えられない。
SUPABASE_DB_URL=
